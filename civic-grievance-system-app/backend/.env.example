ENVIRONMENT=development
SECRET_KEY=change-me-to-a-long-random-secret
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/civic
CORS_ALLOW_ORIGINS=http://localhost:3000
RATE_LIMIT_PER_MINUTE=120
MAX_UPLOAD_MB=8

# Optional — same Client ID as frontend NEXT_PUBLIC_GOOGLE_CLIENT_ID
GOOGLE_CLIENT_ID=

# OS
.DS_Store
Thumbs.db

# Environment & secrets (never commit)
.env
.env.local
.env.*.local
!.env.example
!.env.local.example

# Python
**/.venv/
**/venv/
**/__pycache__/
*.py[cod]
*.egg-info/
.eggs/
dist/
build/

# Node / Next.js
**/node_modules/
**/.next/
**/out/
**/coverage/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ML artifacts (regenerated at runtime if missing)
**/app/ai/models/*.joblib

# Local uploads (Docker volume mirrors this path in dev)
**/app/storage/uploads/
!**/.gitkeep

# IDE
.idea/
.vscode/
*.swp
*.swo
